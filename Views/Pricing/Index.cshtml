@model List<PricingItem>
@{
    ViewData["Title"] = "Pricing Table";
    var items = Model ?? new List<PricingItem>();
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var totalProducts = items.Count;
    var averageMargin = items.Count == 0 ? 0 : items.Average(x => x.MarginPercent);
    var averagePrice = items.Count == 0 ? 0 : items.Average(x => x.Price);
    var totalValue = items.Sum(x => x.Price);
}

<section class="pricing-page">
    <div class="page-header">
        <div>
            <h1>Pricing Table</h1>
        </div>
        <button type="button" class="btn btn-primary btn-add" id="addItemBtn">
            Add product
        </button>
    </div>

    <div class="stats-grid">
        <article class="stat-card">
            <span class="stat-label">Products</span>
            <strong>@totalProducts</strong>
        </article>
        <article class="stat-card">
            <span class="stat-label">Average margin</span>
            <strong>@averageMargin.ToString("0.00")%</strong>
        </article>
        <article class="stat-card">
            <span class="stat-label">Average price</span>
            <strong>$@averagePrice.ToString("N2")</strong>
        </article>
        <article class="stat-card">
            <span class="stat-label">Catalog value</span>
            <strong>$@totalValue.ToString("N2")</strong>
        </article>
    </div>

    <div class="panel">
        <form class="filters" id="filterForm">
            <div class="field grow">
                <label for="search">Search</label>
                <input id="search" name="search" type="search" class="form-control" placeholder="Product name" />
            </div>
            <div class="field">
                <label for="category">Category</label>
                <select id="category" name="category" class="form-select">
                    <option value="">All categories</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="minPrice">Min price</label>
                <input id="minPrice" name="minPrice" type="number" min="0" step="0.01" class="form-control" />
            </div>
            <div class="field">
                <label for="maxPrice">Max price</label>
                <input id="maxPrice" name="maxPrice" type="number" min="0" step="0.01" class="form-control" />
            </div>
            <div class="filter-actions">
                <button type="submit" class="btn btn-dark">Filter</button>
                <button type="button" class="btn btn-outline-secondary" id="resetFilters">Reset</button>
            </div>
        </form>

        <div id="alertHost" class="alert-host" hidden></div>

        <div class="table-wrap">
            <table class="table pricing-table" id="pricingTable">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th class="num">Cost</th>
                        <th class="num">Margin</th>
                        <th class="num">Price</th>
                        <th>Effective</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="pricingTableBody">
                    @if (items.Count == 0)
                    {
                        <tr class="empty-row">
                            <td colspan="8">No products yet. Add one to calculate a sell price.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in items)
                        {
                            <tr data-id="@item.Id">
                                <td>
                                    <div class="product-name">@item.ProductName</div>
                                </td>
                                <td><span class="chip">@item.Category</span></td>
                                <td class="num">$@item.Cost.ToString("N2")</td>
                                <td class="num">@item.MarginPercent.ToString("0.00")%</td>
                                <td class="num price">$@item.Price.ToString("N2")</td>
                                <td>@(item.EffectiveDate?.ToString("MMM d, yyyy") ?? "—")</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="status active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="status inactive">Inactive</span>
                                    }
                                </td>
                                <td class="actions">
                                    <button type="button" class="link-btn edit-btn"
                                            data-id="@item.Id"
                                            data-name="@item.ProductName"
                                            data-category="@item.Category"
                                            data-cost="@item.Cost.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-margin="@item.MarginPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                        Edit
                                    </button>
                                    <button type="button" class="link-btn danger delete-btn" data-id="@item.Id" data-name="@item.ProductName">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<div class="modal fade" id="itemModal" tabindex="-1" aria-labelledby="itemModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="itemForm">
                <div class="modal-header">
                    <h2 class="modal-title" id="itemModalTitle">Add product</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="itemId" />
                    <div class="mb-3">
                        <label for="productName" class="form-label">Product name</label>
                        <input id="productName" class="form-control" maxlength="200" required />
                    </div>
                    <div class="mb-3">
                        <label for="productCategory" class="form-label">Category</label>
                        <input id="productCategory" class="form-control" maxlength="100" required list="categoryOptions" />
                        <datalist id="categoryOptions">
                            @foreach (var category in categories)
                            {
                                <option value="@category"></option>
                            }
                        </datalist>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="productCost" class="form-label">Cost</label>
                            <input id="productCost" class="form-control" type="number" min="0.01" step="0.01" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="productMargin" class="form-label">Target margin (%)</label>
                            <input id="productMargin" class="form-control" type="number" min="0" max="99.99" step="0.01" required />
                        </div>
                    </div>
                    <div class="preview-box">
                        <span>Calculated sell price</span>
                        <strong id="pricePreview">$0.00</strong>
                    </div>
                    <p class="form-error" id="formError" hidden></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="saveItemBtn">Save product</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pricing.js" asp-append-version="true"></script>
}
